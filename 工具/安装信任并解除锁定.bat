@echo off
rem =====================================================================
rem  一键安装本机信任 + 清除「从网络下载」标记（v0.7）
rem
rem  双击本文件即可：
rem    1) 生成/复用本机自签名代码签名证书（当前用户，不需要管理员）
rem    2) 装进「受信任的发布者」和「受信任的根证书颁发机构」
rem       装根证书时 Windows 会弹一次「安全警告」，请点「是」
rem    3) 递归清掉本目录所有文件的 MOTW（这才是蓝色 SmartScreen 的根因）
rem    4) 给 QChatSummary.exe 签名
rem
rem  不改任何 SmartScreen / Defender 策略，不关实时防护，不联网。
rem  失败时会给出中文原因；可重复执行。
rem
rem  编码：本文件用 GBK（代码页 936）保存，改成 UTF-8 会让 cmd 解析中文出错。
rem =====================================================================
setlocal
cd /d "%~dp0"

echo ======================================================================
echo   QQ 摘要 v0.7：安装本机信任并解除文件锁定
echo ======================================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0安装信任并解除锁定.ps1" -RootConsent
set RC=%ERRORLEVEL%

echo.
if "%RC%"=="0" echo [完成] 全部步骤成功。
if "%RC%"=="1" echo [完成但有遗留] 看上面的「遗留事项」，通常是根证书那次确认还没点。
if "%RC%"=="2" echo [失败] 有步骤出错，原因见上面的中文说明（常见：exe 正在运行被占用）。
echo.
pause
exit /b %RC%
